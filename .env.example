# =============================================================================
# VayuDrishti (वायुदृष्टि) — Environment Variables Example
# WeMakeDevs × AWS Environmental Hacks — Track 01: Air
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AIR QUALITY & METEOROLOGICAL TELEMETRY (Optional / Free Tier)
# -----------------------------------------------------------------------------
# The app has built-in real-time fallback to Open-Meteo Air Quality & CPCB
# ground feeds with zero API key required.
# To query WAQI feeds directly, get a free token from:
# https://aqicn.org/data-platform/token/
NEXT_PUBLIC_WAQI_TOKEN=your_waqi_api_token_here

# OpenWeatherMap API key for live temperature/humidity (Free Tier):
# https://openweathermap.org/api
NEXT_PUBLIC_OWM_KEY=your_openweathermap_api_key_here

# -----------------------------------------------------------------------------
# 2. AWS CLOUD & AMAZON BEDROCK CONFIGURATION (Optional for local development)
# -----------------------------------------------------------------------------
# Used by /api/bedrock for live clinical Claude 3.5 Sonnet / Amazon Titan inference.
# Region recommended: ap-south-1 (Mumbai) or us-east-1 (N. Virginia)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Bedrock Model ID:
# Default: anthropic.claude-3-5-sonnet-20240620-v1:0
# Alternative: amazon.titan-text-express-v1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# -----------------------------------------------------------------------------
# 3. AWS NOTIFICATIONS & STORAGE (Optional)
# -----------------------------------------------------------------------------
# Amazon SNS Topic ARN for automated school sentinel SMS alerts:
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:vayudrishti-school-alerts

# Amazon DynamoDB Table Name for crowdsourced reports:
AWS_DYNAMODB_TABLE_REPORTS=vayudrishti-pollution-reports

# -----------------------------------------------------------------------------
# 4. REAL WHATSAPP BOT CONFIGURATION (Twilio OR Meta WhatsApp Cloud API)
# -----------------------------------------------------------------------------
# You can use EITHER Option A (Twilio - fastest for hackathons) OR Option B (Meta).
#
# OPTION A: TWILIO WHATSAPP SANDBOX (Recommended & Fastest — takes 2 mins)
# 1. Sign up at https://www.twilio.com (free $15 trial credits)
# 2. Go to Messaging > Try it out > Send a WhatsApp message
# 3. Join the sandbox from your phone by texting the join code (e.g. "join brave-owl") to +1 415 523 8886
# 4. In Twilio Sandbox Settings, set the webhook URL for incoming messages to:
#    https://<YOUR_DEPLOYED_DOMAIN_OR_NGROK>/api/whatsapp (HTTP POST)
# 5. Copy your Account SID & Auth Token below:
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OPTION B: META / WHATSAPP CLOUD API (Official WhatsApp Business)
# 1. Go to https://developers.facebook.com/ > My Apps > Create App > Other > Business
# 2. Add "WhatsApp" product to your app.
# 3. Under WhatsApp > API Setup, copy the Temporary Access Token and Phone Number ID.
# 4. Under WhatsApp > Configuration > Callback URL:
#    Set URL: https://<YOUR_DEPLOYED_DOMAIN_OR_NGROK>/api/whatsapp
#    Set Verify Token: vayudrishti_sentinel_token
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=vayudrishti_sentinel_token

# -----------------------------------------------------------------------------
# 5. APP URL (For Production Deployment on AWS Amplify / Vercel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
